{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "issue_date": {
      "type": "string"
    },
    "previous_issue_date": {
      "type": "string"
    },
    "publication_date": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string"
    },
    "reporting_window": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "overview": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/citedParagraph"
          },
          {
            "$ref": "#/$defs/limitation"
          }
        ]
      }
    },
    "developments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "pattern": "^[^0-9]*$"
          },
          "event_window": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "string"
                  },
                  "to": {
                    "type": "string"
                  }
                },
                "required": [
                  "from",
                  "to"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "event_timing_note": {
            "type": "string",
            "pattern": "^[^0-9]*$"
          },
          "paragraphs": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "$ref": "#/$defs/citedParagraph"
                },
                {
                  "$ref": "#/$defs/limitation"
                }
              ]
            }
          }
        },
        "required": [
          "title",
          "event_window",
          "event_timing_note",
          "paragraphs"
        ],
        "additionalProperties": false
      }
    },
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "zone": {
            "type": "string",
            "enum": [
              "North East",
              "North Central",
              "North West",
              "South East",
              "South West",
              "South South"
            ]
          },
          "paragraphs": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "$ref": "#/$defs/citedParagraph"
                },
                {
                  "$ref": "#/$defs/limitation"
                },
                {
                  "$ref": "#/$defs/coverageGap"
                }
              ]
            }
          }
        },
        "required": [
          "zone",
          "paragraphs"
        ],
        "additionalProperties": false
      }
    },
    "humanitarian_context": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/citedParagraph"
          },
          {
            "$ref": "#/$defs/limitation"
          }
        ]
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/citedParagraph"
          },
          {
            "$ref": "#/$defs/limitation"
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "issue_date",
    "previous_issue_date",
    "publication_date",
    "reviewed_at",
    "reporting_window",
    "overview",
    "developments",
    "zones",
    "humanitarian_context",
    "limitations"
  ],
  "additionalProperties": false,
  "$defs": {
    "citedParagraph": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "reported",
            "analysis"
          ]
        },
        "text": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source_id": {
                "type": "string"
              },
              "quote": {
                "type": "string",
                "minLength": 12,
                "maxLength": 2000
              }
            },
            "required": [
              "source_id",
              "quote"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "kind",
        "text",
        "source_ids",
        "evidence"
      ],
      "additionalProperties": false
    },
    "limitation": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "limitation"
          ]
        },
        "text": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source_id": {
                "type": "string"
              },
              "quote": {
                "type": "string",
                "minLength": 12,
                "maxLength": 2000
              }
            },
            "required": [
              "source_id",
              "quote"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "kind",
        "text",
        "source_ids",
        "evidence"
      ],
      "additionalProperties": false
    },
    "coverageGap": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "coverage_gap"
          ]
        },
        "text": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 0
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source_id": {
                "type": "string"
              },
              "quote": {
                "type": "string",
                "minLength": 12,
                "maxLength": 2000
              }
            },
            "required": [
              "source_id",
              "quote"
            ],
            "additionalProperties": false
          },
          "maxItems": 0
        }
      },
      "required": [
        "kind",
        "text",
        "source_ids",
        "evidence"
      ],
      "additionalProperties": false
    }
  }
}
